---
import "@repo/ui/styles.css";
import { Toaster } from "@repo/ui/components/ui/sonner";
import { getFaviconPublicSrc } from "../lib/faviconPublicSrc";
import { getAbsoluteUrl, getApiUrl, getWidgetScriptUrl } from "../lib/urls";
import { env } from "../env";

interface Props {
  title?: string;
  description?: string;
  /** Site-relative path of the current page, used for the canonical/og:url. */
  path?: string;
}

const DEFAULT_TITLE = "DeliveryChat - Multi-tenant Chat Platform";
const DEFAULT_DESCRIPTION =
  "Embed a customizable, real-time support chat widget on your website. Multi-tenant SaaS with an operator dashboard, WebSocket messaging, and AI-assisted conversations.";

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  path = "/",
} = Astro.props;

const widgetApiBaseUrl = getApiUrl();
const widgetScriptUrl = getWidgetScriptUrl();
const faviconSrc = getFaviconPublicSrc();
const demoAppId = env.DEMO_CHAT_APP_ID;

const canonicalUrl = getAbsoluteUrl(path);
const ogImageUrl = getAbsoluteUrl("/og-image.png");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href={faviconSrc} sizes="any" />
    <link rel="apple-touch-icon" href={faviconSrc} sizes="180x180" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (LinkedIn, Facebook, WhatsApp, Slack) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DeliveryChat" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="DeliveryChat - real-time chat for your website" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
  </head>
  <body>
    <slot />
    <Toaster client:load richColors />

    <script is:inline>
      (function (w) {
        w.DeliveryChat = w.DeliveryChat || { queue: [] };
        if (!w.DeliveryChat.init) {
          w.DeliveryChat.init = function (opts) {
            w.DeliveryChat.queue.push(["init", opts]);
          };
        }
      })(window);
    </script>
    <script is:inline src={widgetScriptUrl} defer></script>
    <script is:inline define:vars={{ widgetApiBaseUrl, demoAppId }}>
      DeliveryChat.init({
        appId: demoAppId,
        apiBaseUrl: widgetApiBaseUrl,
      });
    </script>
  </body>
</html>

<style>
  html,
  body {
    width: 100%;
    height: 100%;
  }
</style>
